 "SaveAudioAdvanced": {
  "input": {
   "hidden": {
    "extra_pnginfo": [
     "EXTRA_PNGINFO"
    ],
    "prompt": [
     "PROMPT"
    ]
   },
   "required": {
    "audio": [
     "AUDIO",
     {
      "tooltip": "The audio to save."
     }
    ],
    "filename_prefix": [
     "STRING",
     {
      "default": "audio/ComfyUI",
      "multiline": false,
      "tooltip": "The prefix for the file to save. May include formatting tokens such as %date:yyyy-MM-dd%."
     }
    ],
    "format": [
     "COMFY_DYNAMICCOMBO_V3",
     {
      "options": [
       {
        "inputs": {
         "required": {}
        },
        "key": "flac"
       },
       {
        "inputs": {
         "required": {
          "quality": [
           "COMBO",
           {
            "default": "V0",
            "multiselect": false,
            "options": [
             "V0",
             "128k",
             "320k"
            ]
           }
          ]
         }
        },
        "key": "mp3"
       },
       {
        "inputs": {
         "required": {
          "quality": [
           "COMBO",
           {
            "default": "128k",
            "multiselect": false,
            "options": [
             "64k",
             "96k",
             "128k",
             "192k",
             "320k"
            ]
           }
          ]
         }
        },
        "key": "opus"
       }
      ],
      "tooltip": "The file format in which to save the audio."
     }
    ]
   }
  },
  "output": [
   "AUDIO"
  ],
  "output_name": [
   "audio"
  ]
 },
